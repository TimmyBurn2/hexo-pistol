# Build output.
/target
**/*.rs.bk

# Artifacts are never committed (CLAUDE.md rule 8). tools/artifact_check.sh is
# the gate; these entries keep the common cases from ever reaching the index.
*.bin
*.net
*.nnue
*.book
*.npz
*.pt
*.pth
*.safetensors
*.onnx
*.pgn
*.matchlog
*.match.jsonl
/artifacts/
/logs/
/bench-out/

# Session summaries for the operator: working notes, never part of the record
# that CI or a reviewer reads. Same rule as /artifacts/ (CLAUDE.md rule 8).
/sessions/

# Agent harness directories. Scratch belonging to whatever tool is driving
# the session, never to the project; `git add -A` swept 143 of these into a
# commit once (docs/decisions.md D-426 MAJOR 4).
/.agents/
/.claude/
